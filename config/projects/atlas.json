{
  "schema_version": 1,
  "project_id": "atlas",
  "description": "Правила разноски операций компании «Атлас». Для другого клиента создаётся отдельный файл.",
  "default_operation_project": "Общий",
  "rules": [
    {
      "name": "Клиент — проект Орион",
      "when": {"direction": "credit", "contains_all": ["оплат", "орион"]},
      "set": {"article": "Оплата от покупателя", "project": "Орион", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Поступления от покупателей", "pnl_line": "Выручка по договорам подряда", "balance_account": "Выручка", "include_cash_flow": true, "include_pnl": true}
    },
    {
      "name": "Клиент — проект Вектор",
      "when": {"direction": "credit", "contains_all": ["оплат", "вектор"]},
      "set": {"article": "Оплата от покупателя", "project": "Вектор", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Поступления от покупателей", "pnl_line": "Выручка по договорам подряда", "balance_account": "Выручка", "include_cash_flow": true, "include_pnl": true}
    },
    {
      "name": "Аванс клиента — Орион",
      "when": {"direction": "credit", "contains_all": ["аванс", "орион"]},
      "set": {"article": "Аванс от покупателя", "project": "Орион", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Авансы покупателей", "pnl_line": "", "balance_account": "Авансы полученные", "include_cash_flow": true, "include_pnl": false}
    },
    {
      "name": "Аванс клиента — Вектор",
      "when": {"direction": "credit", "contains_all": ["аванс", "вектор"]},
      "set": {"article": "Аванс от покупателя", "project": "Вектор", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Авансы покупателей", "pnl_line": "", "balance_account": "Авансы полученные", "include_cash_flow": true, "include_pnl": false}
    },
    {
      "name": "Подрядчик — Орион",
      "when": {"direction": "debit", "contains_all": ["подряд", "орион"]},
      "set": {"article": "Подрядчики", "project": "Орион", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Оплата подрядчикам", "pnl_line": "Подрядные работы", "balance_account": "Подрядчики", "include_cash_flow": true, "include_pnl": true}
    },
    {
      "name": "Подрядчик — Вектор",
      "when": {"direction": "debit", "contains_all": ["подряд", "вектор"]},
      "set": {"article": "Подрядчики", "project": "Вектор", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Оплата подрядчикам", "pnl_line": "Подрядные работы", "balance_account": "Подрядчики", "include_cash_flow": true, "include_pnl": true}
    },
    {
      "name": "Материалы — Орион",
      "when": {"direction": "debit", "contains_all": ["материал", "орион"]},
      "set": {"article": "Материалы", "project": "Орион", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Оплата материалов", "pnl_line": "Строительные материалы", "balance_account": "Материалы", "include_cash_flow": true, "include_pnl": true}
    },
    {
      "name": "Аванс поставщику — Орион",
      "when": {"direction": "debit", "contains_all": ["аванс", "орион"]},
      "set": {"article": "Аванс поставщику", "project": "Орион", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Авансы поставщикам", "pnl_line": "", "balance_account": "Авансы выданные", "include_cash_flow": true, "include_pnl": false}
    },
    {
      "name": "Аванс поставщику — Вектор",
      "when": {"direction": "debit", "contains_all": ["аванс", "вектор"]},
      "set": {"article": "Аванс поставщику", "project": "Вектор", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Авансы поставщикам", "pnl_line": "", "balance_account": "Авансы выданные", "include_cash_flow": true, "include_pnl": false}
    },
    {
      "name": "Банковская комиссия",
      "when": {"direction": "debit", "contains_any": ["комисси", "расчётное обслуживание", "расчетное обслуживание"]},
      "set": {"article": "Банковское обслуживание", "project": "Общий", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Банковское обслуживание", "pnl_line": "Расчетно-кассовое обслуживание", "balance_account": "Операционные расходы", "include_cash_flow": true, "include_pnl": true}
    },
    {
      "name": "Налоги",
      "when": {"direction": "debit", "contains_any": ["налог", "бюджет"]},
      "set": {"article": "Налоги/взыскания", "project": "Общий", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Прочие налоги и сборы", "pnl_line": "Прочие налоги, сборы, штрафы", "balance_account": "Налоги и взыскания", "include_cash_flow": true, "include_pnl": true}
    },
    {
      "name": "Аренда",
      "when": {"direction": "debit", "contains_any": ["аренд"]},
      "set": {"article": "Аренда", "project": "Общий", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Аренда помещений", "pnl_line": "Аренда офисов", "balance_account": "Операционные расходы", "include_cash_flow": true, "include_pnl": true}
    },
    {
      "name": "Заработная плата",
      "when": {"direction": "debit", "contains_any": ["заработ", "зарплат"]},
      "set": {"article": "Зарплата", "project": "Общий", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Заработная плата", "pnl_line": "Окладные выплаты", "balance_account": "Фонд оплаты труда", "include_cash_flow": true, "include_pnl": true}
    },
    {
      "name": "Получение займа",
      "when": {"direction": "credit", "contains_any": ["получение займа", "получение кредита"]},
      "set": {"article": "Получение кредита/займа", "project": "Общий", "cash_flow_section": "Финансовая деятельность", "cash_flow_line": "Получение кредитов и займов", "pnl_line": "", "balance_account": "Займы", "include_cash_flow": true, "include_pnl": false}
    },
    {
      "name": "Погашение займа",
      "when": {"direction": "debit", "contains_any": ["погашение основной", "погашение кредита"]},
      "set": {"article": "Погашение кредита/займа", "project": "Общий", "cash_flow_section": "Финансовая деятельность", "cash_flow_line": "Погашение кредитов и займов", "pnl_line": "", "balance_account": "Займы", "include_cash_flow": true, "include_pnl": false}
    },
    {
      "name": "Проценты по займу",
      "when": {"direction": "debit", "contains_any": ["процент"]},
      "set": {"article": "Проценты уплаченные", "project": "Общий", "cash_flow_section": "Финансовая деятельность", "cash_flow_line": "Проценты уплаченные", "pnl_line": "Проценты по кредитам", "balance_account": "Операционные расходы", "include_cash_flow": true, "include_pnl": true}
    },
    {
      "name": "Маркетинг — Вектор",
      "when": {"direction": "debit", "contains_all": ["продвиж", "вектор"]},
      "set": {"article": "Маркетинг", "project": "Вектор", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Маркетинг и реклама", "pnl_line": "Реклама в интернете", "balance_account": "Маркетинг", "include_cash_flow": true, "include_pnl": true}
    },
    {
      "name": "Связь и интернет",
      "when": {"direction": "debit", "contains_any": ["связ", "интернет"]},
      "set": {"article": "Связь и интернет", "project": "Общий", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Связь и интернет", "pnl_line": "Расходы на интернет", "balance_account": "Операционные расходы", "include_cash_flow": true, "include_pnl": true}
    },
    {
      "name": "Обучение",
      "when": {"direction": "debit", "contains_any": ["обучен"]},
      "set": {"article": "Обучение", "project": "Общий", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Прочие операционные расходы", "pnl_line": "Расходы на обучение", "balance_account": "Операционные расходы", "include_cash_flow": true, "include_pnl": true}
    },
    {
      "name": "Коммунальные услуги",
      "when": {"direction": "debit", "contains_any": ["коммунал"]},
      "set": {"article": "Коммунальные услуги", "project": "Общий", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Коммунальные услуги", "pnl_line": "Электричество", "balance_account": "Операционные расходы", "include_cash_flow": true, "include_pnl": true}
    },
    {
      "name": "Возврат аванса поставщика",
      "when": {"direction": "credit", "contains_all": ["возврат", "аванс"]},
      "set": {"article": "Возврат от поставщика", "project": "Общий", "cash_flow_section": "Операционная деятельность", "cash_flow_line": "Возвраты от поставщиков", "pnl_line": "", "balance_account": "Авансы выданные", "include_cash_flow": true, "include_pnl": false}
    },
    {
      "name": "Внутренний перевод",
      "when": {"contains_any": ["внутренний перевод", "перевод между своими счетами"]},
      "set": {"article": "Внутренний перевод", "project": "Общий", "cash_flow_section": "Не включать", "cash_flow_line": "Внутренние переводы", "pnl_line": "", "balance_account": "Денежный счет", "include_cash_flow": false, "include_pnl": false}
    }
  ]
}
